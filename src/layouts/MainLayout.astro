---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { siteConfig, socialLinks, profileLinks } from '../data/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = siteConfig.description,
  image = siteConfig.ogImage,
  type = 'website',
  jsonLd
} = Astro.props;

const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const currentPath = Astro.url.pathname;
const canonicalUrl = new URL(currentPath, siteConfig.siteUrl).href;
const ogImageUrl = image.startsWith('http') ? image : new URL(image, siteConfig.siteUrl).href;
const isDefaultOgImage = image === siteConfig.ogImage;
const ogImageAlt = isDefaultOgImage
  ? `${siteConfig.name} — Beneath the surface. Web security & vulnerability research.`
  : title;
---

<!DOCTYPE html>
<html lang={siteConfig.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.name} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    {[...socialLinks, ...profileLinks].map((link) => <link rel="me" href={link.href} />)}
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {isDefaultOgImage && (
      <>
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content={siteConfig.locale} />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="twitter:creator" content={siteConfig.twitterHandle} />
    <meta name="twitter:site" content={siteConfig.twitterHandle} />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="Joshua MARTINELLE" />
    
    <meta name="color-scheme" content="light" />
    <!-- Theme Color -->
    <meta name="theme-color" content="#fcfcfa" />
    <meta name="msapplication-TileColor" content="#fcfcfa" />

    <!-- Structured Data (JSON-LD) -->
    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    <!-- Umami Analytics -->
    <script defer src="https://stats.mrtsec.xyz/script.js" data-website-id="1a333f9d-e53d-442c-b600-26b08fa9a212"></script>
  </head>
  <body class="flex min-h-screen flex-col bg-deep-navy text-text-main antialiased">
    <a class="skip-link" href="#main">Skip to content</a>
    <Navbar currentPath={currentPath} />

    <main id="main" class="flex-1" tabindex="-1">
      <slot />
    </main>
    
    <Footer />
  </body>
</html>
