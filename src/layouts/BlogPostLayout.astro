---
import MainLayout from './MainLayout.astro';
import { Image } from 'astro:assets';
import photo from '../assets/joshua.jpeg';
import { siteConfig } from '../data/site';

interface Props {
  title: string;
  date: Date;
  description: string;
  tags?: string[];
  image?: string;
}

const { title, date, description, tags = [], image } = Astro.props;

// Append the brand suffix only when the title stays within the ~60-char
// limit search engines display; otherwise keep the post title on its own.
const brandSuffix = ' - Joshua Martinelle';
const pageTitle = title.length + brandSuffix.length <= 60 ? `${title}${brandSuffix}` : title;

// Structured data so AI engines and search can attribute the article
const postUrl = new URL(Astro.url.pathname, siteConfig.siteUrl).href;
const author = { '@type': 'Person', name: siteConfig.name, url: siteConfig.siteUrl };

const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  author,
  publisher: author,
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
  url: postUrl,
  ...(image ? { image: new URL(image, siteConfig.siteUrl).href } : {}),
  ...(tags.length ? { keywords: tags.join(', ') } : {}),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog', siteConfig.siteUrl).href },
    { '@type': 'ListItem', position: 3, name: title, item: postUrl },
  ],
};

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<MainLayout title={pageTitle} description={description} image={image} type="article" jsonLd={[blogPostingSchema, breadcrumbSchema]}>
  <article class="site-shell page-shell article-shell">
    <nav class="article-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/blog">Writing</a></nav>
    <header class="article-header">
      {tags.length > 0 && <div class="article-topics">{tags.map(tag => <span>{tag}</span>)}</div>}
      <h1>{title}</h1>
      <p class="article-description">{description}</p>
      <div class="article-byline"><Image src={photo} alt="" width={80} height={80} /><div><a href="/">Joshua MARTINELLE</a><time datetime={date.toISOString()}>{formattedDate}</time></div></div>
      {image && <img src={image} alt={title} class="article-cover" loading="eager" />}
    </header>
    <div class="prose"><slot /></div>
    <footer class="article-footer"><a href="/blog" class="text-link"><span aria-hidden="true">←</span> Back to all articles</a></footer>
  </article>
</MainLayout>
<style>
.article-shell { max-width:1140px; }
.article-breadcrumb { display:flex; gap:12px; color:var(--muted); font-size:.875rem; margin-bottom:36px; }
.article-breadcrumb a:hover { color:var(--signal); }
.article-header { border-bottom:1px solid var(--line); padding-bottom:36px; margin-bottom:40px; }
.article-topics { display:flex; flex-wrap:wrap; gap:8px 20px; margin-bottom:24px; color:var(--signal); font-size:.8125rem; }
h1 { font-size:clamp(2.5rem,5.2vw,4.5rem); letter-spacing:-.055em; max-width:22ch; line-height:1.07; }
.article-description { font-size:1.1875rem; line-height:1.6; color:var(--muted); max-width:65ch; margin-top:26px; }
.article-byline { display:flex; align-items:center; gap:12px; margin-top:28px; font-size:.875rem; }
.article-byline img { width:40px; height:40px; border-radius:50%; }
.article-byline time { display:block; color:var(--muted); font-size:.8125rem; }
.article-cover { margin-top:36px; width:100%; max-height:460px; object-fit:cover; border:1px solid var(--line); }
.article-footer { max-width:760px; margin:56px auto 0; border-top:1px solid var(--line); padding-top:24px; }
@media(max-width:700px) { .article-breadcrumb { margin-bottom:26px; } .article-description { font-size:1.0625rem; } .article-cover { margin-top:26px; } }
</style>
<style is:global>
.prose { max-width:760px; margin-inline:auto; min-width:0; color:var(--ink); font-size:1.0625rem; line-height:1.8; overflow-wrap:break-word; }
.prose h2 { font-size:1.9rem; margin:2.75rem 0 1rem; padding-bottom:.65rem; border-bottom:1px solid var(--line); }
.prose h3 { font-size:1.45rem; margin:2rem 0 .75rem; }
.prose h4 { font-weight:500; font-size:1.125rem; margin:1.5rem 0 .75rem; }
.prose p { margin-bottom:1.25rem; }
.prose a { color:var(--signal); text-decoration:underline; text-decoration-thickness:1px; overflow-wrap:anywhere; }
.prose a:hover { color:var(--color-accent-hover); }
.prose strong { font-weight:700; }
.prose code { font-family:var(--mono); font-size:.85em; background:var(--wash); padding:.15em .3em; border-radius:2px; overflow-wrap:anywhere; }
.prose pre { border:1px solid var(--line); padding:20px; overflow-x:auto; margin:1.75rem 0; font-size:.875rem; line-height:1.7; }
.prose pre code { background:none; padding:0; font-size:inherit; overflow-wrap:normal; }
.prose ul,.prose ol { margin:1.25rem 0; padding-left:1.5rem; }
.prose li { margin-bottom:.5rem; }
.prose ul>li { list-style-type:disc; }
.prose ol>li { list-style-type:decimal; }
.prose blockquote { border-left:2px solid var(--signal); padding-left:1.25rem; margin:1.75rem 0; color:var(--muted); }
.prose img,.prose video { display:block; max-width:100%; height:auto; margin-block:1.5rem; }
.prose iframe { max-width:100%; }
.prose hr { border:0; border-top:1px solid var(--line); margin-block:2.5rem; }
.prose table { display:block; max-width:100%; width:max-content; overflow-x:auto; border-collapse:collapse; margin:1.75rem 0; font-size:.875rem; line-height:1.5; font-variant-numeric:tabular-nums; }
.prose thead th { font-weight:500; color:var(--muted); text-align:left; padding:.75rem; border-bottom:1px solid var(--ink); white-space:nowrap; }
.prose tbody td { padding:.75rem; border-bottom:1px solid var(--line); vertical-align:top; }
.prose #bb-explorer { font-size:.875rem; background:var(--paper); }
.prose #bb-explorer .bb-head { background:var(--wash); }
.prose #bb-explorer :is(.bb-head span,.bb-row>label,.bb-pill,.bb-tile small,.bb-tile em,.bb-section h5,.bb-legend,.bb-cov span,table.bb th,table.bb td.name) { font-size:.75rem; letter-spacing:0; text-transform:none; }
.prose #bb-explorer .bb-pill { padding:.4rem .65rem; font-family:var(--sans); font-size:.8125rem; }
.prose #bb-explorer .bb-pill.on { color:var(--signal); background:var(--wash); border-color:var(--signal); }
.prose #bb-explorer .bb-pill.mode.on { color:white; background:var(--signal); }
.prose #bb-explorer table.bb { display:table; max-width:none; }
.prose #bb-explorer table.bb td { border-color:var(--line); }
@media(max-width:700px) { .prose { font-size:1rem; } .prose h2 { font-size:1.65rem; } .prose pre { padding:16px; } }
</style>
