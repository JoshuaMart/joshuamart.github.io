---
import { Icon } from 'astro-icon/components';
import { siteConfig, socialLinks } from '../data/site';

const currentYear = new Date().getFullYear();

// Footer order: X (Twitter), GitHub, LinkedIn
const order = ['X', 'GitHub', 'LinkedIn'];
const footerSocials = [...socialLinks].sort(
  (a, b) => order.indexOf(a.name) - order.indexOf(b.name)
);
---

<footer class="w-full border-t border-outline-variant bg-deep-navy">
  <div
    class="mx-auto flex max-w-6xl flex-col items-center gap-4 px-4 py-8 sm:px-6 lg:px-8 md:flex-row md:justify-between"
  >
    <span class="font-serif text-lg font-medium text-ochre">
      {siteConfig.name}
    </span>

    <p class="font-mono text-xs uppercase tracking-wider text-sand">
      &copy; {currentYear} {siteConfig.name}. All rights reserved.
    </p>

    <ul class="flex items-center gap-6">
      {footerSocials.map((link) => (
        <li>
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 text-sand transition-colors hover:text-paper"
            aria-label={link.name}
          >
            <Icon name={link.icon} class="h-5 w-5" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>
