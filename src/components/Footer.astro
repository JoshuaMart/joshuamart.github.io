---
import { socialLinks } from '../data/site';
---
<div class="site-shell">
  <footer class="site-footer">
    <span>© {new Date().getFullYear()} Joshua MARTINELLE</span>
    <nav aria-label="Social profiles">{socialLinks.map(link => <a href={link.href} target="_blank" rel="noopener noreferrer">{link.name} <span aria-hidden="true">↗</span></a>)}</nav>
  </footer>
</div>
<style>
.site-footer { border-top:1px solid var(--ink); padding:28px 0 32px; display:flex; align-items:center; justify-content:space-between; gap:20px; flex-wrap:wrap; font-size:.8125rem; }
.site-footer>span { color:var(--muted); }
nav { display:flex; gap:22px; }
a:hover { color:var(--signal); text-decoration:underline; }
@media(max-width:700px) { .site-footer { padding-block:24px; } nav { gap:18px; } }
</style>
