---
import { Icon } from 'astro-icon/components';
import { siteConfig, socialLinks, navLinks } from '../data/site';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

// Normalize path for comparison (remove trailing slash except for root)
const normalizePath = (path: string) => (path === '/' ? '/' : path.replace(/\/$/, ''));
const isActive = (href: string) => normalizePath(currentPath) === normalizePath(href);

// Top navigation shows X (Twitter) and GitHub only
const topSocials = socialLinks.filter((l) => l.name === 'X' || l.name === 'GitHub');
---

<nav class="sticky top-0 z-50 w-full border-b border-outline-variant bg-background/95 backdrop-blur-md">
  <div class="mx-auto flex h-20 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Logo -->
    <a
      href="/"
      class="font-serif text-2xl font-medium tracking-tight text-ochre transition-opacity hover:opacity-80"
    >
      {siteConfig.name}
    </a>

    <!-- Desktop Nav -->
    <ul class="hidden items-center gap-8 md:flex">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'text-base transition-colors',
              isActive(link.href)
                ? 'border-b border-paper pb-1 font-bold text-paper'
                : 'text-sand hover:text-paper',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Desktop right: socials + contact -->
    <div class="hidden items-center gap-2 md:flex">
      {topSocials.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class="flex h-9 w-9 items-center justify-center text-sand transition-colors hover:text-paper"
          aria-label={link.name}
        >
          <Icon name={link.icon} class="h-5 w-5" />
        </a>
      ))}
      <a
        href={`mailto:${siteConfig.contactEmail}`}
        class="ml-2 bg-paper px-6 py-2 font-mono text-xs font-medium uppercase tracking-wider text-deep-navy transition-colors hover:bg-ochre"
      >
        Contact
      </a>
    </div>

    <!-- Mobile menu toggle -->
    <button
      id="mobile-menu-toggle"
      class="text-sand transition-colors hover:text-paper md:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <Icon name="lucide:menu" class="h-6 w-6" data-icon="menu" />
      <Icon name="lucide:x" class="hidden h-6 w-6" data-icon="close" />
    </button>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden border-t border-outline-variant bg-background md:hidden">
    <ul class="flex flex-col px-4 py-4 sm:px-6">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'block py-3 text-base transition-colors',
              isActive(link.href) ? 'font-bold text-paper' : 'text-sand hover:text-paper',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="flex items-center gap-4 border-t border-outline-variant px-4 py-4 sm:px-6">
      {topSocials.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sand transition-colors hover:text-paper"
          aria-label={link.name}
        >
          <Icon name={link.icon} class="h-5 w-5" />
        </a>
      ))}
      <a
        href={`mailto:${siteConfig.contactEmail}`}
        class="ml-auto bg-paper px-6 py-2 font-mono text-xs font-medium uppercase tracking-wider text-deep-navy transition-colors hover:bg-ochre"
      >
        Contact
      </a>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = toggle?.querySelector('[data-icon="menu"]');
  const closeIcon = toggle?.querySelector('[data-icon="close"]');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    menuIcon?.classList.toggle('hidden', isOpen);
    closeIcon?.classList.toggle('hidden', !isOpen);
  });
</script>
