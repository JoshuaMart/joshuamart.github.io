---
import { siteConfig } from '../data/site';
interface Props { currentPath: string; }
const { currentPath } = Astro.props;
const links = [{ href: '/cves', label: 'Research' }, { href: '/blog', label: 'Writing' }, { href: '/tools', label: 'Tools' }];
---
<div class="site-shell">
  <header class="site-header">
    <a href="/" class="wordmark" aria-label="Joshua Martinelle — home">Joshua <span>MARTINELLE</span><i aria-hidden="true">.</i></a>
    <nav aria-label="Main navigation">
      {links.map(link => <a href={link.href} aria-current={currentPath.replace(/\/$/, '') === link.href ? 'page' : currentPath.startsWith(link.href + '/') ? 'location' : undefined}>{link.label}</a>)}
    </nav>
    <a class="contact" href={`mailto:${siteConfig.contactEmail}`}>Let’s talk <span aria-hidden="true">↗</span></a>
  </header>
</div>
<style>
.site-header { min-height:92px; border-bottom:1px solid var(--ink); display:flex; align-items:center; justify-content:space-between; gap:32px; }
.wordmark { font-size:1.125rem; font-weight:700; letter-spacing:-.03em; white-space:nowrap; }
.wordmark span { font-size:.88em; letter-spacing:.035em; }
.wordmark i { font-style:normal; color:var(--signal); margin-left:2px; }
nav { display:flex; gap:30px; font-size:.9375rem; }
nav a { padding-block:12px; }
nav a[aria-current] { color:var(--signal); text-decoration:underline; }
a:hover { color:var(--signal); }
.contact { font-size:.9375rem; display:flex; align-items:center; gap:22px; }
.contact span { color:var(--signal); font-size:1.4rem; }
@media(max-width:700px) { .site-header { min-height:100px; gap:12px; flex-wrap:wrap; padding:20px 0 12px; } .wordmark { font-size:1rem; } nav { order:3; width:100%; gap:28px; font-size:.875rem; } nav a { padding-block:8px; } .contact { font-size:.875rem; gap:8px; } }
</style>
