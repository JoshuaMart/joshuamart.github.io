---
import { Image } from 'astro:assets';
import photo from '../../assets/design-preview/joshua.jpeg';
import LayerStudy from './LayerStudy.astro';
import AnimatedAnatomy from './AnimatedAnatomy.astro';
import cves from '../../data/cves.json';
import tools from '../../data/tools.json';
import '@fontsource/eb-garamond/500.css';
import '@fontsource/eb-garamond/500-italic.css';
import '@fontsource/hanken-grotesk/400.css';
import '@fontsource/hanken-grotesk/500.css';
import '@fontsource/hanken-grotesk/700.css';
import '@fontsource/jetbrains-mono/400.css';
interface Props { direction: 'dossier' | 'lab' }
const { direction } = Astro.props;
const dossier = direction === 'dossier';
const selected = [cves.find(c => c.id === 'CVE-2026-20896'), cves.find(c => c.id === 'CVE-2026-82123')].filter(Boolean);
const articleUrl = 'https://www.jomar.fr/blog/2026/bugbounty-agent-benchmark/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light" />
    <title>{dossier ? 'Research dossier' : 'Open laboratory'} — Joshua MARTINELLE</title>
    <meta name="description" content="Design exploration for Joshua Martinelle’s personal security research website." />
  </head>
  <body class={direction}>
    <a class="skip" href="#main">Skip to content</a>
    <div class="site-wrap">
      <header class="site-header">
        <a href="#main" class="wordmark">Joshua <span>MARTINELLE</span><i aria-hidden="true">.</i></a>
        <nav aria-label="Main navigation"><a href="#research">Research</a><a href="#writing">Writing</a><a href={dossier ? "#about" : "#contact"}>{dossier ? "About" : "Contact"}</a></nav>
        <a class="contact" href="mailto:contact@jomar.fr">Let’s talk <span aria-hidden="true">↗</span></a>
      </header>
      <main id="main">
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-copy">
            <p class="eyebrow"><span class="signal-dot" aria-hidden="true"></span> Web security & vulnerability research</p>
            <h1 id="hero-title">{dossier ? <>Beneath<br/>the <em>surface.</em></> : <><span class="hero-first-line"><span>Beneath</span><Image class="hero-avatar" src={photo} alt="" width={160} height={160} loading="eager" /></span><span>the <em>surface.</em></span></>}</h1>
            <div class="hero-intro">
              <span class="index-label" aria-hidden="true">01 / INTRO</span>
              <div><p>I’m Joshua, a security engineer at Tenable.<br class="desktop-break"/> I research web vulnerabilities, build tools,<br class="desktop-break"/> and write about what I find.</p>
              <a class="text-link" href="#research">Explore my research <span aria-hidden="true">↓</span></a></div>
            </div>
          </div>
          <div class="hero-visual">
            {dossier ? <figure class="portrait"><div class="portrait-frame"><Image src={photo} alt="Joshua Martinelle" widths={[320,640]} sizes="(max-width: 650px) 70vw, 320px" loading="eager" fetchpriority="high" /></div><figcaption><span>Joshua MARTINELLE</span><span>Security Engineer @ Tenable</span></figcaption><span class="photo-index" aria-hidden="true">JM / FIELD NOTES</span></figure> : <><div class="study-overline"><span>FIG. 01 — ANATOMY OF A FINDING</span><span aria-hidden="true">[ + ]</span></div><AnimatedAnatomy /></>}
          </div>
        </section>
        <section class="evidence" aria-label="Research record">
          <p class="record-label">A public record<br/>of asking questions.</p>
          <div><strong>{cves.length}</strong><span>Published CVEs</span></div>
          <div><strong>{cves.filter(c=>c.severity==='Critical').length}</strong><span>Critical findings</span></div>
          <a href="https://www.jomar.fr/cves/"><span>Research archive</span><span class="archive-years">2020–2026 <span aria-hidden="true">↗</span></span></a>
        </section>
        <section class="research section" id="research" aria-labelledby="research-title">
          <div class="section-heading"><div><span class="section-index">02 / SELECTED WORK</span><h2 id="research-title">Following the evidence.</h2></div><a class="quiet-link" href="https://www.jomar.fr/cves/">All disclosures <span aria-hidden="true">↗</span></a></div>
          <div class="research-layout">
            <div class="findings">
              {selected.map((c, index)=> c && <a class="finding-row" href={c.link} target="_blank" rel="noopener noreferrer"><div class="finding-top"><span class="cve-id">{c.id}</span><span class:list={['severity',c.severity.toLowerCase()]}>{c.severity}</span></div><div class="finding-title"><h3>{c.type}<span>in {c.product}</span></h3><span class="row-arrow" aria-hidden="true">↗</span></div><p>{index === 0 ? 'An authentication flaw in Gitea. Read the vendor’s release notes and security advisory.' : 'A reflected cross-site scripting vulnerability in WordPress Loops & Logic. Read the disclosure.'}</p><span class="finding-bottom">{c.date}<span>Read advisory <span aria-hidden="true">↗</span></span></span></a>)}
            </div>
            {dossier && <aside class="research-note"><span class="section-index">A CLOSER LOOK</span><LayerStudy variant="dossier"/><p>The interesting part is often<br/>one layer deeper.</p></aside>}
          </div>
        </section>
        <section class="writing section" id="writing" aria-labelledby="writing-title">
          <div class="section-heading"><div><span class="section-index">03 / FROM THE NOTEBOOK</span><h2 id="writing-title">Research, written down.</h2></div><a class="quiet-link" href="https://www.jomar.fr/blog/">All writing <span aria-hidden="true">↗</span></a></div>
          <article class="featured-article">
            <div class="article-margin"><time datetime="2026-09-08">08 September 2026</time><span>AI / Bug bounty</span><div class="article-mark" aria-hidden="true">{dossier ? 'Aa' : '↳'}</div><span class="margin-note">From the benchmark<br/>to the findings.</span></div>
            <div class="article-main"><a href={articleUrl}><h3>Bugbounty agent<br/>benchmark<span aria-hidden="true"> ↗</span></h3></a><p class="article-deck">Six models. Seven harnesses. One browser.<br/>What actually makes a bug bounty agent better?</p><div class="excerpt"><span class="excerpt-label">From the article</span><p>“I wrote the specification before any code. Goals and non-goals, vocabulary, the invariants a proof has to satisfy, the scoring rule, the analysis plan.”</p></div><a class="text-link" href={articleUrl}>Read the research <span aria-hidden="true">↗</span></a></div>
          </article>
        </section>
        <section class="tools section" id="tools" aria-labelledby="tools-title"><div class="section-heading"><div><span class="section-index">04 / BUILT ALONG THE WAY</span><h2 id="tools-title">Tools for the work.</h2></div><a class="quiet-link" href="https://github.com/JoshuaMart" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a></div><div class="tool-list">{tools.slice(0,3).map((tool,index)=><a class="tool" href={tool.url} target="_blank" rel="noopener noreferrer"><span class="tool-number">0{index+1}</span><div><h3>{tool.name}</h3><p>{tool.description}</p></div><span class="language">{tool.language}</span><span aria-hidden="true">↗</span></a>)}</div></section>
        {dossier ? <section id="about" class="about section" aria-labelledby="about-title"><div><span class="section-index">05 / THE PERSON BEHIND THE WORK</span><h2 id="about-title">Curiosity is<br/>a good starting point.</h2></div><div class="about-copy"><p>I’m Joshua MARTINELLE, a security engineer at Tenable and a bug hunter focused on web security.</p><p>This is where I share my vulnerability disclosures, research notes, and the tools I build along the way.</p><a class="text-link" href="mailto:contact@jomar.fr">Start a conversation <span aria-hidden="true">↗</span></a></div></section> : <section id="contact" class="contact-section section" aria-labelledby="contact-title"><div><span class="section-index">05 / GET IN TOUCH</span><h2 id="contact-title">Let’s compare notes.</h2></div><div class="contact-copy"><p>A question about a finding, an idea to explore, or a speaking invitation?</p><a class="text-link" href="mailto:contact@jomar.fr">contact@jomar.fr <span aria-hidden="true">↗</span></a></div></section>}
      </main>
      <footer>{dossier ? <><a class="wordmark" href="#main">Joshua <span>MARTINELLE</span><i aria-hidden="true">.</i></a><p>Security research. In the open.</p></> : <span class="footer-credit">© 2026 Joshua MARTINELLE</span>}<div><a href="https://github.com/JoshuaMart">GitHub ↗</a><a href="https://x.com/J0_mart">X ↗</a><a href="https://www.linkedin.com/in/joshua-martinelle-a34911133/">LinkedIn ↗</a></div>{dossier && <span class="copyright">© 2026</span>}</footer>
    </div>
  </body>
</html>
<script>
  // Keep the design comparison available when opening published work.
  document.querySelectorAll<HTMLAnchorElement>('a[href^="https://"]').forEach(link => {
    link.target = '_blank';
    link.rel = 'noopener noreferrer';
  });
</script>
<style is:global>
  :root{color-scheme:light;font-family:'Hanken Grotesk',sans-serif;font-size:16px;font-weight:400;-webkit-font-smoothing:antialiased;--sans:'Hanken Grotesk',sans-serif;--serif:'EB Garamond',Georgia,serif;--mono:'JetBrains Mono',monospace}
  *{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:32px}body{margin:0;color:var(--ink);background:var(--paper)}
  body.dossier{--paper:#f7f4ec;--ink:#292b26;--muted:#64655e;--signal:#af392b;--line:#d1cfc4;--wash:#e7e4da;--heading:var(--serif)}
  body.lab{--paper:#fcfcfa;--ink:#202a32;--muted:#5e6870;--signal:#204be3;--line:#d5dadf;--wash:#edf0f7;--heading:var(--sans)}
  ::selection{background:var(--signal);color:#fff}a{color:inherit;text-decoration:none;text-underline-offset:5px}a:hover{text-decoration:underline;text-decoration-thickness:1px}button,a{-webkit-tap-highlight-color:transparent}a:focus-visible,button:focus-visible{outline:2px solid var(--signal);outline-offset:5px}button:active{transform:scale(.97)}img{display:block;max-width:100%;height:auto}p{line-height:1.6;text-wrap:pretty}h1,h2,h3,p,figure{margin:0}h1,h2,h3{font-weight:500}h2,h3{text-wrap:balance}h2{font:500 2.75rem/1.15 var(--heading);letter-spacing:-.025em}h3{letter-spacing:-.02em}a,div,section{min-width:0}.site-wrap{max-width:1360px;padding:0 64px;margin:0 auto}.skip{position:absolute;top:8px;left:16px;padding:12px;background:var(--paper);transform:translateY(-200%);z-index:10}.skip:focus{transform:none}
  .site-header{min-height:108px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:32px}.wordmark{font-size:1.125rem;font-weight:500;letter-spacing:-.03em;white-space:nowrap}.wordmark span{font-size:.88em;letter-spacing:.035em}.wordmark i{font-style:normal;color:var(--signal);font-weight:700;margin-left:2px}.site-header nav{display:flex;gap:30px;font-size:.875rem}.contact{font-size:.875rem;display:flex;align-items:center;gap:22px}.contact>span{color:var(--signal);font-size:1.25rem}
  .hero{display:grid;grid-template-columns:1.4fr 1fr;gap:48px;align-items:center;padding:66px 0 58px}.eyebrow,.section-index,.index-label,.cve-id,.finding-bottom,.study-overline,.excerpt-label{font:400 .6875rem/1.5 var(--mono);letter-spacing:.02em}.eyebrow{display:flex;gap:10px;align-items:center;color:var(--muted);font-family:var(--sans);font-size:.8125rem}.signal-dot{width:6px;height:6px;background:var(--signal);border-radius:50%;flex-shrink:0}h1{font:500 clamp(4rem,7.8vw,7.1rem)/.97 var(--heading);letter-spacing:-.055em;margin:26px 0 34px}h1 em{font-family:var(--serif);font-style:italic;font-weight:500;color:var(--signal)}.hero-intro{display:grid;grid-template-columns:90px 1fr;gap:24px}.index-label{color:var(--muted);padding-top:5px}.hero-intro p{font-size:1rem;line-height:1.65}.text-link{display:inline-flex;align-items:center;gap:28px;border-bottom:1px solid var(--signal);padding:8px 0;color:var(--signal);font-size:.875rem;margin-top:20px}.text-link:hover{text-decoration:none}.text-link span{transition:transform 180ms cubic-bezier(.23,1,.32,1)}.portrait{position:relative;max-width:308px;margin:8px 28px 0 auto}.portrait-frame{position:relative}.portrait-frame:before{content:'';position:absolute;inset:14px -14px -14px 14px;border:1px solid var(--line);z-index:-1}.portrait img{width:100%;aspect-ratio:4/5;object-fit:cover;object-position:50% 40%}.portrait figcaption{display:flex;flex-direction:column;gap:3px;margin-top:29px;font-size:.75rem;line-height:1.5}.portrait figcaption span:last-child{color:var(--muted)}.photo-index{position:absolute;left:calc(100% + 24px);top:0;writing-mode:vertical-rl;font:400 .625rem/1 var(--mono);letter-spacing:.04em;color:var(--muted)}
  .evidence{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;border-top:1px solid var(--line);border-bottom:1px solid var(--line);align-items:center;padding:24px 0;gap:20px}.record-label{font-size:.8125rem;color:var(--muted)}.evidence>div{display:flex;align-items:center;gap:16px}.evidence strong{font:500 3.15rem/1 var(--heading);letter-spacing:-.05em}.evidence div>span{font-size:.8125rem;max-width:72px;line-height:1.45}.evidence>a{justify-self:end;display:flex;flex-direction:column;gap:7px;font-size:.75rem;color:var(--muted)}.archive-years{font:400 .8125rem/1.5 var(--mono);color:var(--ink)}.archive-years>span{padding-left:24px;color:var(--signal)}
  .section{padding:72px 0 0}.section-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:34px}.section-index{display:block;color:var(--muted);margin-bottom:13px}.quiet-link{font-size:.8125rem;white-space:nowrap;padding-bottom:4px}.quiet-link span{margin-left:12px;color:var(--signal)}.research-layout{display:grid;grid-template-columns:1.6fr 1fr;gap:64px}.finding-row{display:block;border-top:1px solid var(--line);padding:24px 0}.finding-row:hover{text-decoration:none}.finding-top,.finding-title,.finding-bottom{display:flex;align-items:center;justify-content:space-between;gap:18px}.cve-id{color:var(--muted)}.severity{font-size:.6875rem;display:flex;align-items:center;gap:6px}.severity:before{content:'';height:5px;width:5px;background:currentColor}.critical{color:#a5372b}.medium{color:#785518}.finding-title{margin-top:15px}.finding-title h3{font:500 1.95rem/1.15 var(--heading)}.finding-title h3 span{display:block;color:var(--muted)}.row-arrow{font-size:1.55rem;color:var(--signal)}.finding-row>p{font-size:.875rem;color:var(--muted);max-width:54ch;margin-top:15px}.finding-bottom{margin-top:24px;color:var(--muted);font-size:.625rem}.finding-bottom>span{color:var(--ink)}.research-note{border-top:1px solid var(--line);padding-top:24px;align-self:start}.research-note>p{font:500 1.8rem/1.15 var(--serif);letter-spacing:-.02em;padding:28px 0}.research-note .layer-study{margin-top:16px}
  .featured-article{display:grid;grid-template-columns:1fr 2.2fr;border-top:1px solid var(--ink);border-bottom:1px solid var(--line);padding:38px 0 42px;gap:50px}.article-margin{display:flex;flex-direction:column;align-items:flex-start;gap:8px;color:var(--muted);font-size:.75rem}.article-mark{font:500 8rem/1.2 var(--serif);color:var(--signal);margin-top:12px;letter-spacing:-.07em}.margin-note{line-height:1.5}.article-main h3{font:500 3.25rem/1.05 var(--heading);letter-spacing:-.035em}.article-main h3 span{color:var(--signal);font-family:var(--sans);font-size:1.8rem;vertical-align:middle}.article-main>a:hover{text-decoration:none}.article-deck{color:var(--muted);font-size:1rem;margin-top:20px}.excerpt{margin-top:30px;padding:0 0 0 22px;border-left:2px solid var(--signal);max-width:61ch}.excerpt-label{color:var(--muted);font-size:.625rem;display:block;margin-bottom:10px}.excerpt p{font:500 1.5rem/1.45 var(--serif);text-wrap:pretty}.tool-list{border-top:1px solid var(--line)}.tool{display:grid;grid-template-columns:70px 1fr 90px 22px;gap:20px;align-items:center;padding:25px 0;border-bottom:1px solid var(--line)}.tool-number{font:400 .6875rem/1 var(--mono);color:var(--muted)}.tool h3{font-size:1.25rem;line-height:1.2}.tool p{font-size:.875rem;color:var(--muted);margin-top:5px}.language{font:400 .6875rem/1 var(--mono);color:var(--muted)}.tool>span:last-child{color:var(--signal)}.tool:hover{text-decoration:none}.about{display:grid;grid-template-columns:1.2fr 1fr;gap:80px;padding-bottom:72px}.about-copy{padding-top:28px}.about-copy p{font-size:1rem;max-width:48ch}.about-copy p+p{margin-top:14px;color:var(--muted)}footer{border-top:1px solid var(--ink);padding:28px 0 32px;display:flex;align-items:center;gap:28px;flex-wrap:wrap}footer p{font-size:.75rem;color:var(--muted)}footer>div{display:flex;gap:22px;margin-left:auto;font-size:.75rem}.copyright{font-size:.625rem;color:var(--muted)}
  .lab .site-header{min-height:92px;border-color:var(--ink)}.lab .wordmark{font-weight:700}.lab .hero{grid-template-columns:1.15fr 1fr;gap:42px;padding:64px 0 50px}.lab h1{font-size:clamp(4rem,7.15vw,6.7rem);line-height:1.02;font-weight:500;letter-spacing:-.07em}.lab h1 em{font-family:var(--sans);font-style:normal;font-weight:500}.lab .hero-intro{display:block;max-width:390px}.lab .index-label{display:none}.study-overline{display:flex;justify-content:space-between;color:var(--muted);border-top:1px solid var(--line);padding-top:14px}.mini-profile{display:flex;align-items:center;gap:14px;margin-top:24px}.mini-profile img{width:48px;height:48px;object-fit:cover;border-radius:50%}.mini-profile p{font-size:.75rem;font-weight:500}.mini-profile p span{display:block;color:var(--muted);font-weight:400}.lab .evidence{grid-template-columns:1fr 1fr 1fr 1fr;background:var(--wash);border:0;padding:26px 28px}.lab .evidence strong{font-size:2.75rem;font-weight:500}.lab h2{font-size:2.25rem;letter-spacing:-.045em}.lab .research-layout{display:block}.lab .findings{display:grid;grid-template-columns:1fr 1fr;gap:44px}.lab .finding-title h3{font-size:1.75rem;line-height:1.2}.lab .finding-row{border-top:2px solid var(--signal);padding-top:24px}.lab .finding-title{margin-top:23px}.lab .featured-article{grid-template-columns:.7fr 2fr;background:var(--wash);border:0;padding:40px;gap:50px}.lab .article-main h3{font-size:3rem;letter-spacing:-.055em}.lab .article-mark{font-family:var(--sans);font-size:7rem;line-height:1.1}.lab .excerpt p{font-family:var(--sans);font-size:1.125rem;font-weight:400;line-height:1.6}.lab .tool-number{color:var(--signal)}.lab .about h2{font-size:2.75rem}
  @media(hover:hover) and (pointer:fine){.finding-row:hover h3,.tool:hover h3,.article-main>a:hover h3{color:var(--signal)}.text-link:hover span{transform:translate(2px,-2px)}}
  @media(min-width:1500px){.site-wrap{max-width:1400px}}
  @media(max-width:1000px){.site-wrap{padding:0 36px}.hero{gap:28px}.hero-intro{grid-template-columns:1fr}.index-label{display:none}.portrait{max-width:270px;margin-right:20px}.research-layout{gap:36px}.evidence>div{gap:10px}.record-label{font-size:.75rem}.evidence strong{font-size:2.75rem}.featured-article{grid-template-columns:.8fr 2fr}.lab .featured-article{gap:30px;padding:30px}.about{gap:40px}.lab .evidence{padding:24px 18px}.lab .evidence div>span{font-size:.75rem}}
  @media(max-width:700px){.site-wrap{padding:0 22px}.site-header,.lab .site-header{min-height:100px;gap:12px;flex-wrap:wrap;padding:20px 0 16px}.wordmark{font-size:1rem}.site-header nav{order:3;width:100%;gap:28px;font-size:.8125rem}.site-header nav a{padding:6px 0}.contact{font-size:.8125rem;gap:12px}.hero,.lab .hero{grid-template-columns:1fr;padding:38px 0 32px;gap:32px}.eyebrow{font-size:.75rem}h1,.lab h1{font-size:clamp(3.75rem,14vw,5.8rem);margin:24px 0 26px}.hero-intro p{font-size:.9375rem}.desktop-break{display:none}.hero-visual{width:100%}.portrait{max-width:100%;display:grid;grid-template-columns:125px 1fr;gap:24px;align-items:end;margin:0 16px 0 0}.portrait img{aspect-ratio:1/1.15}.portrait figcaption{margin:0 0 5px;font-size:.6875rem;line-height:1.6}.photo-index{display:none}.portrait-frame:before{inset:8px -8px -8px 8px}.evidence,.lab .evidence{grid-template-columns:1fr 1fr;gap:20px;padding:22px 0;background:none;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.record-label{grid-column:1/-1;font-size:.75rem}.record-label br{display:none}.evidence>div{gap:13px}.evidence div>span{font-size:.75rem;max-width:75px}.evidence strong,.lab .evidence strong{font-size:2.8rem}.evidence>a{grid-column:1/-1;justify-self:stretch;flex-direction:row;justify-content:space-between;border-top:1px solid var(--line);padding-top:16px}.section{padding-top:46px}.section-heading{gap:15px;align-items:flex-start;margin-bottom:24px;flex-wrap:wrap}.section-index{font-size:.625rem;margin-bottom:10px}h2,.lab h2{font-size:2rem;line-height:1.15}.quiet-link{font-size:.75rem}.research-layout{display:block}.research-note{margin-top:12px;padding:20px 0;display:none}.findings,.lab .findings{display:block}.finding-title h3,.lab .finding-title h3{font-size:1.75rem}.finding-top{gap:12px}.cve-id{font-size:.625rem}.finding-row{padding:22px 0}.finding-row>p{font-size:.8125rem}.finding-bottom{margin-top:18px}.featured-article,.lab .featured-article{grid-template-columns:1fr;gap:24px;padding:25px 0;background:none;border-top:1px solid var(--ink);border-bottom:1px solid var(--line)}.article-margin{flex-direction:row;flex-wrap:wrap;gap:12px;font-size:.6875rem}.article-mark,.margin-note{display:none}.article-main h3,.lab .article-main h3{font-size:2.5rem}.article-deck{font-size:.875rem}.excerpt{margin-top:24px;padding-left:16px}.excerpt p{font-size:1.35rem;line-height:1.5}.lab .excerpt p{font-size:1rem}.tool{grid-template-columns:24px 1fr 20px;gap:12px;padding:20px 0}.tool h3{font-size:1.125rem}.tool p{font-size:.8125rem}.language{display:none}.about{grid-template-columns:1fr;gap:22px;padding-bottom:46px}.about-copy{padding-top:0}.about-copy p{font-size:.9375rem}.lab .about h2{font-size:2.25rem}footer{gap:20px;padding:25px 0}footer p{display:none}footer>div{order:3;width:100%;margin:0;gap:24px}.copyright{margin-left:auto}.lab .hero-visual{max-width:460px;margin:0 auto}.study-overline{font-size:.625rem}.lab .mini-profile{margin-top:14px}.lab .hero .layer-study svg{max-height:270px}.lab .hero .layer-study .study-caption{font-size:.625rem}}
