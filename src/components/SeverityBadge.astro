---
interface Props { severity: 'Critical' | 'High' | 'Medium' | 'Low'; class?: string; }
const { severity, class: className = '' } = Astro.props;
---
<span class:list={['severity-badge', className]} style={`--severity: var(--color-${severity.toLowerCase()})`}><span aria-hidden="true"></span>{severity}</span>
<style>
.severity-badge { display:inline-flex; flex-shrink:0; align-items:center; gap:7px; color:var(--severity); font-size:.8125rem; line-height:1.5; white-space:nowrap; }
.severity-badge>span { width:5px; height:5px; background:currentColor; }
</style>
