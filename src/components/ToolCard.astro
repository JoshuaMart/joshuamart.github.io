---
import { Icon } from 'astro-icon/components';
interface Props { name:string; description:string; language:string; icon:string; url:string; }
const { name, description, language, icon, url } = Astro.props;
---
<a href={url} target="_blank" rel="noopener noreferrer" class="tool-card" data-name={name.toLowerCase()} data-description={description.toLowerCase()} data-language={language}>
  <div class="tool-meta"><span>{language}</span><span aria-hidden="true">↗</span></div>
  <div class="tool-title"><Icon name={icon} class="h-5 w-5" /><h2>{name}</h2></div>
  <p>{description}</p>
</a>
<style>
.tool-card { display:flex; flex-direction:column; min-width:0; border-top:1px solid var(--signal); padding:24px 0 32px; }
.tool-meta { display:flex; align-items:center; justify-content:space-between; color:var(--muted); font:400 .75rem/1.5 var(--mono); }
.tool-meta>span:last-child { color:var(--signal); font-size:1.4rem; }
.tool-title { display:flex; gap:12px; align-items:center; margin-top:26px; }
h2 { font-size:1.75rem; }
p { color:var(--muted); font-size:1rem; margin-top:14px; max-width:55ch; }
a:hover h2 { color:var(--signal); }
</style>
