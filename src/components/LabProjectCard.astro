---
import { Icon } from 'astro-icon/components';
interface Props { name:string; description:string; language:string; icon:string; status:string; }
const { name, description, language, icon, status } = Astro.props;
---
<article class="lab-project">
  <div class="project-meta"><span>{language}</span><span>{status}</span></div>
  <div class="project-title"><Icon name={icon} class="h-5 w-5" /><h3>{name}</h3></div>
  <p>{description}</p>
</article>
<style>
.lab-project { border-top:1px solid var(--line); padding:24px 0 28px; min-width:0; }
.project-meta { display:flex; gap:12px; flex-wrap:wrap; justify-content:space-between; color:var(--muted); font-size:.8125rem; }
.project-title { display:flex; gap:12px; align-items:center; margin-top:26px; }
h3 { font-size:1.75rem; }
p { color:var(--muted); margin-top:14px; max-width:55ch; }
</style>
