---
import { Icon } from 'astro-icon/components';
import SeverityBadge from './SeverityBadge.astro';

interface CVE {
  id: string;
  target: string;
  product: string;
  type: string;
  severity: 'Critical' | 'High' | 'Medium' | 'Low';
  date: string;
  link: string;
}

interface Props {
  cves: CVE[];
  limit?: number;
}

const { cves, limit } = Astro.props;
const displayedCves = limit ? cves.slice(0, limit) : cves;

const dataAttrs = (cve: CVE) => ({
  'data-cve-id': cve.id.toLowerCase(),
  'data-cve-target': cve.target.toLowerCase(),
  'data-cve-product': cve.product.toLowerCase(),
  'data-cve-type': cve.type.toLowerCase(),
  'data-cve-year': cve.date,
});
---

<!-- Desktop Table -->
<div class="hidden overflow-x-auto md:block">
  <table aria-label="Published vulnerability disclosures" class="cve-table w-full min-w-[720px] border-collapse border-b border-outline-variant text-left">
    <thead>
      <tr class="border-b border-outline-variant">
        <th scope="col" class="w-44 px-4 py-4 text-sm text-sand">ID</th>
        <th scope="col" class="px-4 py-4 text-sm text-sand">Type</th>
        <th scope="col" class="px-4 py-4 text-sm text-sand">Product</th>
        <th scope="col" class="w-32 px-4 py-4 text-sm text-sand">Severity</th>
        <th scope="col" class="w-32 px-4 py-4 text-right text-sm text-sand">Link</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-outline-variant">
      {displayedCves.map((cve) => (
        <tr class="cve-row group transition-colors hover:bg-surface-high" {...dataAttrs(cve)}>
          <td class="px-4 py-5 font-mono text-xs text-paper">{cve.id}</td>
          <td class="px-4 py-5 font-medium text-paper transition-colors group-hover:text-ochre">
            {cve.type}
          </td>
          <td class="px-4 py-5 text-sand">{cve.product}</td>
          <td class="px-4 py-5">
            <SeverityBadge severity={cve.severity} variant="inline" />
          </td>
          <td class="px-4 py-5 text-right">
            <a
              href={cve.link}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-sm text-sand transition-colors hover:text-ochre"
              aria-label={`View reference for ${cve.id}`}
            >
              View
              <Icon name="lucide:arrow-right" class="h-4 w-4" />
            </a>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<!-- Mobile Cards -->
<div class="flex flex-col md:hidden">
  {displayedCves.map((cve) => (
    <article class="cve-row border-t border-outline-variant py-6" {...dataAttrs(cve)}>
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <span class="font-mono text-xs text-paper">{cve.id}</span>
          <h2 class="mt-2 font-sans text-xl font-medium text-paper">{cve.type}</h2>
          <p class="mt-1 text-sm text-sand">{cve.product}</p>
        </div>
        <SeverityBadge severity={cve.severity} variant="inline" />
      </div>
      <div class="mt-4 flex items-center justify-between text-sm text-sand">
        <span>{cve.date}</span>
        <a
          href={cve.link}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-ochre"
          aria-label={`View reference for ${cve.id}`}
        >
          View
          <Icon name="lucide:arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </article>
  ))}
</div>

<style>
  .cve-table th { font-weight:400; }
  .cve-table :is(th,td):first-child { padding-left:0; }
  .cve-table :is(th,td):last-child { padding-right:0; }
</style>
