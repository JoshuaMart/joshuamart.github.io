---
import { Icon } from 'astro-icon/components';
import SeverityBadge from './SeverityBadge.astro';

interface CVE {
  id: string;
  target: string;
  product: string;
  type: string;
  severity: 'Critical' | 'High' | 'Medium' | 'Low';
  date: string;
  link: string;
}

interface Props {
  cves: CVE[];
  limit?: number;
}

const { cves, limit } = Astro.props;
const displayedCves = limit ? cves.slice(0, limit) : cves;

const dataAttrs = (cve: CVE) => ({
  'data-cve-id': cve.id.toLowerCase(),
  'data-cve-target': cve.target.toLowerCase(),
  'data-cve-type': cve.type.toLowerCase(),
  'data-cve-year': cve.date,
});
---

<!-- Desktop Table -->
<div class="hidden overflow-x-auto border border-outline-variant bg-surface-container md:block">
  <table class="w-full min-w-[720px] border-collapse text-left">
    <thead>
      <tr class="border-b border-outline-variant bg-surface-low">
        <th class="w-48 px-6 py-5 font-mono text-xs uppercase tracking-widest text-sand">ID</th>
        <th class="px-6 py-5 font-mono text-xs uppercase tracking-widest text-sand">Type</th>
        <th class="px-6 py-5 font-mono text-xs uppercase tracking-widest text-sand">Product</th>
        <th class="w-32 px-6 py-5 font-mono text-xs uppercase tracking-widest text-sand">Severity</th>
        <th class="w-32 px-6 py-5 text-right font-mono text-xs uppercase tracking-widest text-sand">Link</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-outline-variant">
      {displayedCves.map((cve) => (
        <tr class="cve-row group transition-colors hover:bg-surface-high" {...dataAttrs(cve)}>
          <td class="px-6 py-6 font-mono text-xs tracking-widest text-paper">{cve.id}</td>
          <td class="px-6 py-6 font-medium text-paper transition-colors group-hover:text-ochre">
            {cve.type}
          </td>
          <td class="px-6 py-6 text-sand">{cve.product}</td>
          <td class="px-6 py-6">
            <SeverityBadge severity={cve.severity} />
          </td>
          <td class="px-6 py-6 text-right">
            <a
              href={cve.link}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 font-mono text-xs uppercase tracking-widest text-sand transition-colors hover:text-ochre"
              aria-label={`View reference for ${cve.id}`}
            >
              View
              <Icon name="lucide:arrow-right" class="h-4 w-4" />
            </a>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<!-- Mobile Cards -->
<div class="flex flex-col gap-4 md:hidden">
  {displayedCves.map((cve) => (
    <article class="cve-row border border-outline-variant bg-surface-container p-5" {...dataAttrs(cve)}>
      <div class="flex items-start justify-between gap-4">
        <div>
          <span class="font-mono text-xs tracking-widest text-paper">{cve.id}</span>
          <h3 class="mt-2 font-serif text-xl font-medium text-paper">{cve.type}</h3>
          <p class="mt-1 text-sm text-sand">{cve.product}</p>
        </div>
        <SeverityBadge severity={cve.severity} />
      </div>
      <div class="mt-4 flex items-center justify-between border-t border-outline-variant pt-4 font-mono text-xs uppercase tracking-widest text-sand">
        <span>{cve.date}</span>
        <a
          href={cve.link}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-ochre"
        >
          View
          <Icon name="lucide:arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </article>
  ))}
</div>
