---
interface Item {
  value: string;
  label: string;
  /** Optional colour for a leading dot (e.g. severity). */
  color?: string;
  /** Optional count shown after the label. */
  count?: number;
}

interface Props {
  items: Item[];
  group: string;
  label?: string;
  /** Renders the label as a mono uppercase index, like `.section-index`. */
  monoLabel?: boolean;
}

const { items, group, label, monoLabel = false } = Astro.props;
---

<div class="flex flex-wrap items-center gap-x-2 gap-y-3">
  {label && (
    <span class:list={['mr-4 text-sand', monoLabel ? 'font-mono text-xs uppercase' : 'text-sm']}>{label}</span>
  )}
  <div class="flex flex-wrap items-center gap-2" data-filter-pills={group} role="group" aria-label={label || `Filter by ${group}`}>
    {items.map((item, i) => (
      <button
        type="button"
        data-filter={item.value}
        aria-pressed={i === 0}
        class:list={[
          'filter-pill transition-colors',
          i === 0 && 'is-active',
        ]}
      >
        {item.color && <span class="filter-dot" style={`background:${item.color}`} aria-hidden="true"></span>}
        {item.label}
        {item.count !== undefined && <span class="filter-count">{item.count}</span>}
      </button>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-filter-pills]').forEach((group) => {
    const pills = group.querySelectorAll<HTMLButtonElement>('.filter-pill');
    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        pills.forEach((p) => { p.classList.remove('is-active'); p.setAttribute('aria-pressed', 'false'); });
        pill.classList.add('is-active');
        pill.setAttribute('aria-pressed', 'true');
        group.dispatchEvent(
          new CustomEvent('filter-change', {
            bubbles: true,
            detail: {
              group: group.dataset.filterPills,
              value: pill.dataset.filter,
            },
          })
        );
      });
    });
  });
</script>
