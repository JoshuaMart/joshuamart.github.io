---
interface Props { title: string; description: string; date: Date; slug: string; tags?: string[]; }
const { title, description, date, slug, tags = [] } = Astro.props;
const formattedDate = date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: '2-digit' });
---
<article class="post-item" data-tags={JSON.stringify(tags)}>
  <a href={`/blog/${slug}`}>
    <div class="post-meta"><time datetime={date.toISOString()}>{formattedDate}</time>{tags[0] && <span>{tags[0]}</span>}</div>
    <div><h2>{title}</h2><p>{description}</p></div>
    <span class="post-arrow" aria-hidden="true">↗</span>
  </a>
</article>
<style>
.post-item { border-top:1px solid var(--line); }
a { display:grid; grid-template-columns:160px 1fr 24px; gap:32px; padding-block:32px; }
.post-meta { display:flex; flex-direction:column; gap:8px; font-size:.8125rem; color:var(--muted); padding-top:6px; }
.post-meta>span { color:var(--signal); }
h2 { font-size:clamp(1.5rem,2.7vw,2rem); max-width:35ch; }
p { margin-top:14px; max-width:68ch; color:var(--muted); }
.post-arrow { color:var(--signal); font-size:1.5rem; }
a:hover h2 { color:var(--signal); }
@media(max-width:700px) { a { grid-template-columns:1fr 20px; gap:16px; padding-block:26px; } .post-meta { grid-column:1/-1; flex-direction:row; flex-wrap:wrap; gap:16px; padding:0; } p { font-size:.9375rem; } }
</style>
