<hairline-anatomy>
  <div class="anatomy-artwork">
    <div class="anatomy-canvas"></div>
    <svg class="anatomy-fallback" viewBox="0 0 480 384" role="img" aria-label="An application viewed as four separate layers">
      <g fill="var(--paper)" stroke="var(--muted)" stroke-width="1">
        <path d="m70 242 170-85 170 85-170 85Z"/>
        <path d="m70 202 170-85 170 85-170 85Z"/>
        <path d="m70 162 170-85 170 85-170 85Z"/>
        <path d="m70 122 170-85 170 85-170 85Z"/>
      </g>
    </svg>
  </div>
  <div class="anatomy-caption">
    <span>Look beneath each layer.</span>
  </div>
</hairline-anatomy>

<script>
  import { exploded, type Figure } from '@lucasmarkes/hairline';

  class HairlineAnatomy extends HTMLElement {
    private figure?: Figure;
    private controller?: AbortController;

    connectedCallback() {
      if (this.figure) return;
      const canvas = this.querySelector<HTMLElement>('.anatomy-canvas')!;
      const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
      this.controller = new AbortController();
      const { signal } = this.controller;

      this.figure = exploded(canvas, {
        theme: 'light',
        intensity: 0.4,
        play: !motion.matches && !document.hidden,
        label: 'An application unfolding into four layers, revealing its internal structure.',
      });
      this.setAttribute('data-ready', '');

      const sync = () => {
        this.figure?.update({ play: !motion.matches && !document.hidden });
      };
      motion.addEventListener('change', sync, { signal });
      document.addEventListener('visibilitychange', sync, { signal });
      sync();
    }

    disconnectedCallback() {
      this.controller?.abort();
      this.figure?.destroy();
      this.figure = undefined;
      this.removeAttribute('data-ready');
    }
  }

  if (!customElements.get('hairline-anatomy')) {
    customElements.define('hairline-anatomy', HairlineAnatomy);
  }
</script>

<style>
  hairline-anatomy {
    display: block;
    --hairline-plate: var(--paper);
    --hairline-hi: var(--signal);
    --hairline-edge: #566574;
    --hairline-mid: #7b8997;
    --hairline-lo: #d2d9e1;
    --hairline-stroke: .9;
  }
  /* Frame the drawing itself instead of Hairline's generous outer canvas.
     The shorter opening travel keeps every layer inside this tighter crop. */
  .anatomy-artwork { position: relative; aspect-ratio: 1.45; width: 100%; overflow: clip; }
  .anatomy-canvas { position: absolute; width: 100%; aspect-ratio: 5 / 4; transform: translateY(-17%) scale(1.7); transform-origin: 38% 80%; }
  .anatomy-fallback { display: block; position: absolute; inset: 0; width: 100%; height: 100%; }
  [data-ready] .anatomy-fallback { display: none; }
  .anatomy-caption { border-top: 1px solid var(--line); padding: 16px 0; font-size: .75rem; color: var(--muted); }
</style>
