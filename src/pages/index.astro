---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import MainLayout from '../layouts/MainLayout.astro';
import AnimatedAnatomy from '../components/AnimatedAnatomy.astro';
import SeverityBadge from '../components/SeverityBadge.astro';
import photo from '../assets/joshua.jpeg';
import { siteConfig, socialLinks, profileLinks } from '../data/site';
import cves from '../data/cves.json';
import tools from '../data/tools.json';
import '../styles/home.css';

const personSchema = {
  '@context': 'https://schema.org', '@type': 'Person', name: siteConfig.name,
  url: siteConfig.siteUrl, image: new URL(photo.src, siteConfig.siteUrl).href,
  jobTitle: siteConfig.role, description: siteConfig.description,
  worksFor: { '@type': 'Organization', name: siteConfig.company },
  sameAs: [...socialLinks, ...profileLinks].map(link => link.href),
};
const websiteSchema = {
  '@context': 'https://schema.org', '@type': 'WebSite', name: siteConfig.name,
  url: siteConfig.siteUrl, description: siteConfig.description,
  author: { '@type': 'Person', name: siteConfig.name, url: siteConfig.siteUrl },
};
const selected = ['CVE-2026-20896', 'CVE-2026-82123'].flatMap(id => cves.filter(c => c.id === id));
const years = cves.map(c => Number(c.date));
const posts = (await getCollection('blog')).sort((a,b) => b.data.date.getTime() - a.data.date.getTime());
const featured = posts.find(post => post.id === '2026/bugbounty-agent-benchmark') ?? posts[0];
const isBenchmark = featured?.id === '2026/bugbounty-agent-benchmark';
---
<MainLayout title={`${siteConfig.name} - ${siteConfig.role}`} jsonLd={[personSchema, websiteSchema]}>
  <div class="site-shell home">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="signal-dot" aria-hidden="true"></span> Web security & vulnerability research</p>
        <h1 id="hero-title"><span class="hero-first-line"><span>Beneath</span><Image class="hero-avatar" src={photo} alt="" width={160} height={160} loading="eager" fetchpriority="high" /></span><span>the <em>surface.</em></span></h1>
        <div class="hero-intro"><p>I’m Joshua, a security engineer at Tenable.<br class="desktop-break"/> I research web vulnerabilities, build tools,<br class="desktop-break"/> and write about what I find.</p><a class="text-link" href="#research">Explore my research <span aria-hidden="true">↓</span></a></div>
      </div>
      <div class="hero-visual"><div class="study-overline"><span>FIG. 01 — ANATOMY OF A FINDING</span><span aria-hidden="true">[ + ]</span></div><AnimatedAnatomy /></div>
    </section>
    <section class="evidence" aria-label="Research record">
      <p class="record-label">A public record<br/>of asking questions.</p>
      <div><strong>{cves.length}</strong><span>Published CVEs</span></div>
      <div><strong>{cves.filter(c=>c.severity==='Critical').length}</strong><span>Critical findings</span></div>
      <a href="/cves"><span>Research archive</span><span class="archive-years">{Math.min(...years)}–{Math.max(...years)} <span aria-hidden="true">↗</span></span></a>
    </section>
    <section class="section" id="research" aria-labelledby="research-title">
      <div class="section-heading"><div><span class="section-index">02 / SELECTED WORK</span><h2 id="research-title">Following the evidence.</h2></div><a class="quiet-link" href="/cves">All disclosures <span aria-hidden="true">↗</span></a></div>
      <div class="findings">{selected.map((c,index)=><a class="finding-row" href={c.link} target="_blank" rel="noopener noreferrer"><div class="finding-top"><span class="cve-id">{c.id}</span><SeverityBadge severity={c.severity} /></div><div class="finding-title"><h3>{c.type}<span>in {c.product}</span></h3><span class="row-arrow" aria-hidden="true">↗</span></div><p>{index === 0 ? 'An authentication flaw in Gitea. Read the vendor’s release notes and security advisory.' : 'A reflected cross-site scripting vulnerability in WordPress Loops & Logic. Read the disclosure.'}</p><span class="finding-bottom">{c.date}<span>Read advisory <span aria-hidden="true">↗</span></span></span></a>)}</div>
    </section>
    {featured && <section class="section" id="writing" aria-labelledby="writing-title">
      <div class="section-heading"><div><span class="section-index">03 / FROM THE NOTEBOOK</span><h2 id="writing-title">Research, written down.</h2></div><a class="quiet-link" href="/blog">All writing <span aria-hidden="true">↗</span></a></div>
      <article class="featured-article"><div class="article-margin"><time datetime={featured.data.date.toISOString()}>{featured.data.date.toLocaleDateString('en-GB',{day:'2-digit',month:'long',year:'numeric'})}</time><span>{featured.data.tags?.slice(0,2).join(' / ')}</span><div class="article-mark" aria-hidden="true">↳</div>{isBenchmark && <span class="margin-note">From the benchmark<br/>to the findings.</span>}</div><div class="article-main"><a href={`/blog/${featured.id}`}><h3>{featured.data.title}<span aria-hidden="true"> ↗</span></h3></a><p class="article-deck">{isBenchmark ? <>Six models. Seven harnesses. One browser.<br/>What actually makes a bug bounty agent better?</> : featured.data.description}</p>{isBenchmark && <div class="excerpt"><span class="excerpt-label">From the article</span><blockquote>“I wrote the specification before any code. Goals and non-goals, vocabulary, the invariants a proof has to satisfy, the scoring rule, the analysis plan.”</blockquote></div>}<a class="text-link" href={`/blog/${featured.id}`}>Read the research <span aria-hidden="true">↗</span></a></div></article>
    </section>}
    <section class="section" id="tools" aria-labelledby="tools-title"><div class="section-heading"><div><span class="section-index">04 / BUILT ALONG THE WAY</span><h2 id="tools-title">Tools for the work.</h2></div><a class="quiet-link" href="/tools">All tools <span aria-hidden="true">↗</span></a></div><div class="tool-list">{tools.slice(0,3).map((tool,index)=><a class="tool" href={tool.url} target="_blank" rel="noopener noreferrer"><span class="tool-number">0{index+1}</span><div><h3>{tool.name}</h3><p>{tool.description}</p></div><span class="language">{tool.language}</span><span aria-hidden="true">↗</span></a>)}</div></section>
    <section id="contact" class="contact-section section" aria-labelledby="contact-title"><div><span class="section-index">05 / GET IN TOUCH</span><h2 id="contact-title">Let’s compare notes.</h2></div><div class="contact-copy"><p>A question about a finding, an idea to explore, or a speaking invitation?</p><a class="text-link" href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail} <span aria-hidden="true">↗</span></a></div></section>
  </div>
</MainLayout>
