---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import MainLayout from '../layouts/MainLayout.astro';
import HeroVault from '../components/HeroVault.astro';
import SeverityBadge from '../components/SeverityBadge.astro';
import PostCard from '../components/PostCard.astro';
import ToolCard from '../components/ToolCard.astro';
import photo from '../assets/joshua.jpeg';
import { siteConfig, socialLinks, profileLinks } from '../data/site';
import cves from '../data/cves.json';
import tools from '../data/tools.json';
import { advisorySource } from '../utils/advisorySource';
import { readingMinutes } from '../utils/readingTime';
import '../styles/home.css';

const personSchema = {
  '@context': 'https://schema.org', '@type': 'Person', name: siteConfig.name,
  url: siteConfig.siteUrl, image: new URL(photo.src, siteConfig.siteUrl).href,
  jobTitle: siteConfig.role, description: siteConfig.description,
  worksFor: { '@type': 'Organization', name: siteConfig.company },
  sameAs: [...socialLinks, ...profileLinks].map(link => link.href),
};
const websiteSchema = {
  '@context': 'https://schema.org', '@type': 'WebSite', name: siteConfig.name,
  url: siteConfig.siteUrl, description: siteConfig.description,
  author: { '@type': 'Person', name: siteConfig.name, url: siteConfig.siteUrl },
};
const selected = ['CVE-2026-20896', 'CVE-2026-82123'].flatMap(id => cves.filter(c => c.id === id));
const firstYear = Math.min(...cves.map(c => Number(c.date)));
const record = [
  { value: cves.length, label: 'Published CVEs' },
  { value: cves.filter(c => c.severity === 'Critical').length, label: 'Critical findings', severity: 'Critical' },
  { value: new Set(cves.map(c => c.product)).size, label: 'Products affected' },
  { value: `${new Date().getFullYear() - firstYear}+`, label: `Years disclosing, since ${firstYear}` },
];
const posts = (await getCollection('blog')).sort((a,b) => b.data.date.getTime() - a.data.date.getTime());
const postTitle = (slug?: string) => posts.find(post => post.id === slug)?.data.title;
const featured = posts.find(post => post.id === '2026/bugbounty-agent-benchmark') ?? posts[0];
const isBenchmark = featured?.id === '2026/bugbounty-agent-benchmark';
---
<MainLayout title={`${siteConfig.name} - ${siteConfig.role}`} jsonLd={[personSchema, websiteSchema]}>
  <div class="site-shell home">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="signal-dot" aria-hidden="true"></span> Web security & vulnerability research</p>
        <h1 id="hero-title"><span class="hero-first-line"><span>Beneath</span><Image class="hero-avatar" src={photo} alt="" width={160} height={160} loading="eager" fetchpriority="high" /></span><span>the <em>surface.</em></span></h1>
        <div class="hero-intro"><p>I’m Joshua, a security engineer at Tenable.<br class="desktop-break"/> I research web vulnerabilities, build tools,<br class="desktop-break"/> and write about what I find.</p><a class="text-link" href="#research">Explore my research <span aria-hidden="true">↓</span></a></div>
      </div>
      <div class="hero-visual"><div class="study-overline"><span>FIG. 01 — CRACKING THE COMBINATION</span><span aria-hidden="true">[ + ]</span></div><HeroVault /></div>
    </section>
    <section class="evidence" aria-labelledby="record-title">
      <div class="evidence-head"><span id="record-title" class="section-index">A public record of asking questions</span><a href="/cves">Research archive <span aria-hidden="true">↗</span></a></div>
      <dl class="evidence-stats">{record.map(r => <div><dt>{r.label}</dt><dd data-severity={r.severity}>{r.value}</dd></div>)}</dl>
    </section>
    <section class="section" id="research" aria-labelledby="research-title">
      <div class="section-heading"><div><span class="section-index">02 / SELECTED WORK</span><h2 id="research-title">Following the evidence.</h2></div><a class="quiet-link" href="/cves">All disclosures <span aria-hidden="true">↗</span></a></div>
      <div class="findings">{selected.map((c,index)=><a class="finding-row" href={c.link} target="_blank" rel="noopener noreferrer"><div class="finding-top"><span class="cve-id">{c.id}</span><SeverityBadge severity={c.severity as 'Critical' | 'High' | 'Medium' | 'Low'} variant="inline" /></div><div class="finding-title"><h3>{c.type}<span>in {c.product}</span></h3><span class="row-arrow" aria-hidden="true">↗</span></div><p>{index === 0 ? 'An authentication flaw in Gitea. Read the vendor’s release notes and security advisory.' : 'A reflected cross-site scripting vulnerability in WordPress Loops & Logic. Read the disclosure.'}</p><span class="finding-bottom">{c.date} · {advisorySource(c.link)}<span>Read advisory <span aria-hidden="true">↗</span></span></span></a>)}</div>
    </section>
    {featured && <section class="section" id="writing" aria-labelledby="writing-title">
      <div class="section-heading"><div><span class="section-index">03 / FROM THE NOTEBOOK</span><h2 id="writing-title">Research, written down.</h2></div><a class="quiet-link" href="/blog">All writing <span aria-hidden="true">↗</span></a></div>
      <div class="featured-article"><PostCard variant="lead" title={featured.data.title} description={isBenchmark ? 'Six models. Seven harnesses. One browser. What actually makes a bug bounty agent better?' : featured.data.description} date={featured.data.date} slug={featured.id} tags={featured.data.tags} image={featured.data.image} minutes={readingMinutes(featured.body)}>{isBenchmark && <div class="excerpt"><span class="excerpt-label">From the article</span><blockquote>“I wrote the specification before any code. Goals and non-goals, vocabulary, the invariants a proof has to satisfy, the scoring rule, the analysis plan.”</blockquote></div>}</PostCard></div>
    </section>}
    <section class="section" id="tools" aria-labelledby="tools-title"><div class="section-heading"><div><span class="section-index">04 / BUILT ALONG THE WAY</span><h2 id="tools-title">Tools for the work.</h2></div><a class="quiet-link" href="/tools">All tools <span aria-hidden="true">↗</span></a></div><div class="tool-grid">{tools.slice(0,3).map((tool,index)=><ToolCard name={tool.name} description={tool.description} language={tool.language} icon={tool.icon} url={tool.url} index={index+1} post={tool.post} postTitle={postTitle(tool.post)} />)}</div></section>
    <section id="contact" class="contact-section section" aria-labelledby="contact-title"><div><span class="section-index">05 / GET IN TOUCH</span><h2 id="contact-title">Let’s compare notes.</h2></div><div class="contact-copy"><p>A question about a finding, an idea to explore, or a speaking invitation?</p><a class="text-link" href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail} <span aria-hidden="true">↗</span></a></div></section>
  </div>
</MainLayout>
