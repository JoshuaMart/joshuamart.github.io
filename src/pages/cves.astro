---
import { Icon } from 'astro-icon/components';
import MainLayout from '../layouts/MainLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import FilterPills from '../components/FilterPills.astro';
import CveArchive from '../components/CveArchive.astro';
import { siteConfig } from '../data/site';
import cves from '../data/cves.json';

type Severity = 'Critical' | 'High' | 'Medium' | 'Low';
const severities: Severity[] = ['Critical', 'High', 'Medium', 'Low'];

// Sort by date descending (most recent first)
const sortedCves = [...cves].sort((a, b) => b.date.localeCompare(a.date)) as (typeof cves[number] & { severity: Severity })[];

const totalCves = cves.length;
const years = [...new Set(cves.map((c) => c.date))].sort((a, b) => b.localeCompare(a));
const latest = sortedCves[0];

const stats = [
  { label: 'Disclosures', value: totalCves },
  { label: 'Critical findings', value: cves.filter((c) => c.severity === 'Critical').length, severity: 'Critical' },
  { label: 'Products affected', value: new Set(cves.map((c) => c.product)).size },
  { label: 'Years of disclosures', value: years.length },
];

// Bar heights scale against the busiest year.
const BAR_MAX = 120;
const perYear = [...years].reverse().map((year) => ({ year, count: cves.filter((c) => c.date === year).length }));
const maxPerYear = Math.max(...perYear.map((y) => y.count));

const perSeverity = severities.map((severity) => {
  const count = cves.filter((c) => c.severity === severity).length;
  return { severity, count, pct: Math.round((count / totalCves) * 100) };
});

const yearItems = [{ value: 'all', label: 'All' }, ...years.map((y) => ({ value: y, label: y }))];
const severityItems = [
  { value: 'all', label: 'All' },
  ...severities.map((s) => ({ value: s, label: s, color: `var(--color-${s.toLowerCase()})` })),
];
---

<MainLayout
  title="Vulnerability Research - Joshua Martinelle"
  description="Comprehensive database of disclosed security vulnerabilities discovered by Joshua Martinelle."
>
  <section class="site-shell page-shell">
    <div class="archive-top">
      <PageHeader
        eyebrow="RESEARCH ARCHIVE — 001"
        title="CVEs & research."
        description="Vulnerabilities I’ve found and disclosed, with links to vendor advisories and technical details."
        class="archive-header"
      />
      <dl class="archive-meta">
        <div><dt>Latest disclosure</dt><dd class="mono">{latest.id}</dd></div>
        <div><dt>Coordinated with</dt><dd>{siteConfig.company} Research, vendors</dd></div>
        <div><dt>Active since</dt><dd class="mono">{years[years.length - 1]}</dd></div>
      </dl>
    </div>

    <!-- Stats strip -->
    <section aria-label="Overview" class="stats">
      {stats.map((stat) => (
        <div class="stat">
          <p class="stat-value" data-severity={stat.severity}>{stat.value}</p>
          <p class="stat-label">{stat.label}</p>
        </div>
      ))}
    </section>

    <!-- Visual overview -->
    <section class="overview">
      <div>
        <div class="overview-head">
          <span class="section-index">DISCLOSURES / YEAR</span>
          <span>Select a year to filter</span>
        </div>
        <div class="timeline" style={`--cols:${perYear.length}`}>
          {perYear.map(({ year, count }) => (
            <button
              type="button"
              class="timeline-bar"
              data-year={year}
              aria-pressed="false"
              aria-label={`${year}: ${count} disclosures`}
            >
              <span class="bar-count" data-bar-count>{count}</span>
              <span class="bar-fill" data-bar-fill style={`height:${Math.max(3, Math.round((count / maxPerYear) * BAR_MAX))}px`}></span>
              <span class="bar-year">{year}</span>
            </button>
          ))}
        </div>
      </div>
      <div>
        <div class="overview-head">
          <span class="section-index">SEVERITY DISTRIBUTION</span>
          <span>CVSS rating</span>
        </div>
        <div class="severity-bar" aria-hidden="true">
          {perSeverity.map(({ severity, count }) => (
            <span data-severity={severity} data-sev-segment={severity} style={`flex-grow:${count}`}></span>
          ))}
        </div>
        <ul class="severity-legend">
          {perSeverity.map(({ severity, count, pct }) => (
            <li data-severity={severity} data-sev-legend={severity}>
              <span class="legend-dot" aria-hidden="true"></span>
              <span>{severity}</span>
              <span class="mono" data-sev-count>{count}</span>
              <span class="mono legend-pct" data-sev-pct>{pct}%</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Toolbar -->
    <section aria-label="Filter the archive" class="toolbar">
      <div class="relative">
        <Icon
          name="lucide:search"
          class="absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-sand"
        />
        <input
          type="search"
          aria-label="Search vulnerabilities"
          id="cve-search"
          placeholder="Search CVE ID, product or vulnerability"
          class="archive-search w-full border border-outline-variant bg-surface-container py-3 pl-11 pr-4 sm:pr-24 text-base text-paper placeholder:text-sand focus:border-ochre focus:outline-none"
        />
        <kbd class="hidden sm:block absolute right-4 top-1/2 -translate-y-1/2 border border-outline-variant bg-surface-low px-2 py-0.5 font-mono text-xs text-sand">
          ⌘ K
        </kbd>
      </div>

      <div class="toolbar-filters">
        <div class="toolbar-pills">
          <FilterPills items={yearItems} group="years" label="Year" monoLabel />
          <FilterPills items={severityItems} group="severity" label="Severity" monoLabel />
        </div>
        <p class="text-sm text-sand" role="status">
          Showing <span id="shown-count" class="font-mono text-paper">{totalCves}</span> of {totalCves}
        </p>
      </div>
    </section>

    <CveArchive cves={sortedCves} />

    <div id="cves-empty" class="archive-empty" hidden>
      <span class="section-index">0 RESULTS</span>
      <p>No vulnerabilities match your search and filters.</p>
      <button type="button" id="cves-reset" class="text-link">Reset filters <span aria-hidden="true">↺</span></button>
    </div>

    <!-- Disclosure note -->
    <section class="disclosure">
      <div>
        <span class="section-index">DISCLOSURE POLICY</span>
        <p>Every finding listed here went through coordinated disclosure. Advisories are linked once the vendor has shipped a fix or the disclosure deadline has passed.</p>
      </div>
      <a class="text-link" href={`mailto:${siteConfig.contactEmail}`}>Report a vulnerability to me <span aria-hidden="true">↗</span></a>
    </section>
  </section>

  <script define:vars={{ barMax: BAR_MAX }}>
    const searchInput = document.getElementById('cve-search');
    const rows = [...document.querySelectorAll('.cve-row')];
    const groups = [...document.querySelectorAll('[data-year-group]')];
    const bars = [...document.querySelectorAll('.timeline-bar')];
    const shownCount = document.getElementById('shown-count');
    const empty = document.getElementById('cves-empty');

    let currentYear = 'all';
    let currentSeverity = 'all';

    const matchesTerm = (row, term) =>
      !term ||
      ['cveId', 'cveTarget', 'cveProduct', 'cveType'].some((key) => (row.dataset[key] || '').includes(term));
    const matchesYear = (row) => currentYear === 'all' || row.dataset.cveYear === currentYear;
    const matchesSeverity = (row) => currentSeverity === 'all' || row.dataset.cveSeverity === currentSeverity;
    const countLabel = (n) => `${n} ${n === 1 ? 'disclosure' : 'disclosures'}`;

    function applyFilters() {
      const term = searchInput.value.trim().toLowerCase();
      let shown = 0;

      rows.forEach((row) => {
        const visible = matchesTerm(row, term) && matchesYear(row) && matchesSeverity(row);
        row.hidden = !visible;
        if (visible) row.querySelector('[data-row-num]').textContent = String(++shown).padStart(2, '0');
      });

      groups.forEach((group) => {
        const count = group.querySelectorAll('.cve-row:not([hidden])').length;
        group.hidden = count === 0;
        group.querySelector('[data-year-count]').textContent = countLabel(count);
      });

      // Year chart reflects search + severity; severity chart reflects search + year.
      const byYear = rows.filter((r) => matchesTerm(r, term) && matchesSeverity(r));
      const yearCounts = bars.map((bar) => byYear.filter((r) => r.dataset.cveYear === bar.dataset.year).length);
      const maxYear = Math.max(...bars.map((bar) => rows.filter((r) => r.dataset.cveYear === bar.dataset.year).length));
      bars.forEach((bar, i) => {
        const active = currentYear === bar.dataset.year;
        bar.setAttribute('aria-pressed', String(active));
        bar.classList.toggle('is-dim', currentYear !== 'all' && !active);
        bar.querySelector('[data-bar-count]').textContent = yearCounts[i];
        bar.querySelector('[data-bar-fill]').style.height = `${Math.max(3, Math.round((yearCounts[i] / maxYear) * barMax))}px`;
        bar.setAttribute('aria-label', `${bar.dataset.year}: ${yearCounts[i]} disclosures`);
      });

      const bySeverity = rows.filter((r) => matchesTerm(r, term) && matchesYear(r));
      document.querySelectorAll('[data-sev-legend]').forEach((item) => {
        const severity = item.dataset.sevLegend;
        const count = bySeverity.filter((r) => r.dataset.cveSeverity === severity).length;
        item.querySelector('[data-sev-count]').textContent = count;
        item.querySelector('[data-sev-pct]').textContent = `${bySeverity.length ? Math.round((count / bySeverity.length) * 100) : 0}%`;
        document.querySelector(`[data-sev-segment="${severity}"]`).style.flexGrow = count;
      });

      shownCount.textContent = String(shown);
      empty.hidden = shown > 0;
    }

    // Selecting a pill keeps FilterPills as the single source of truth for the active state.
    const selectPill = (group, value) =>
      document.querySelector(`[data-filter-pills="${group}"] [data-filter="${value}"]`)?.click();

    searchInput.addEventListener('input', applyFilters);

    document.addEventListener('filter-change', (e) => {
      const { group, value } = e.detail;
      if (group === 'years') currentYear = value;
      else if (group === 'severity') currentSeverity = value;
      else return;
      applyFilters();
    });

    bars.forEach((bar) =>
      bar.addEventListener('click', () => selectPill('years', currentYear === bar.dataset.year ? 'all' : bar.dataset.year))
    );

    document.getElementById('cves-reset').addEventListener('click', () => {
      searchInput.value = '';
      selectPill('years', 'all');
      selectPill('severity', 'all');
      applyFilters();
    });

    document.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
        e.preventDefault();
        searchInput.focus();
      }
    });
  </script>
</MainLayout>

<style>
  .mono { font-family:var(--mono); font-size:.8125rem; font-weight:500; }
  .archive-top { display:grid; grid-template-columns:minmax(0,1fr) 340px; gap:64px; align-items:end; margin-bottom:56px; }
  .archive-top :global(.archive-header) { margin-bottom:0; }
  .archive-meta { border-top:1px solid var(--ink); }
  .archive-meta div { display:flex; justify-content:space-between; gap:16px; padding-block:14px; border-bottom:1px solid var(--line); font-size:.875rem; }
  .archive-meta dt { color:var(--muted); }

  .stats { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); border-top:1px solid var(--ink); border-bottom:1px solid var(--line); }
  .stat { padding:28px 24px; }
  .stat:first-child { padding-left:0; }
  .stat + .stat { border-left:1px solid var(--line); }
  .stat-value { font-size:3.25rem; font-weight:500; letter-spacing:-.05em; line-height:1; }
  .stat-value[data-severity] { color:var(--severity-color); }
  .stat-label { margin-top:12px; color:var(--muted); font-size:.875rem; }

  .overview { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:64px; padding:40px 0 56px; border-bottom:1px solid var(--ink); }
  .overview-head { display:flex; justify-content:space-between; align-items:baseline; gap:16px; margin-bottom:20px; color:var(--muted); font-size:.8125rem; }
  .overview-head .section-index { margin:0; }
  .timeline { display:grid; grid-template-columns:repeat(var(--cols),minmax(0,1fr)); gap:10px; align-items:end; height:176px; }
  .timeline-bar { display:flex; flex-direction:column; justify-content:flex-end; gap:8px; height:100%; min-height:44px; text-align:left; font:400 .75rem/1 var(--mono); color:var(--ink); }
  .bar-count { font-weight:500; }
  .bar-fill { display:block; background:var(--ink); transition:height 200ms ease-out, background-color 150ms ease-out; }
  .bar-year { padding-top:6px; border-top:1px solid var(--ink); }
  .timeline-bar:hover .bar-fill { background:var(--signal); }
  .timeline-bar.is-dim { color:var(--muted); }
  .timeline-bar.is-dim .bar-fill { background:var(--line); }
  .timeline-bar[aria-pressed="true"] { color:var(--signal); }
  .timeline-bar[aria-pressed="true"] .bar-fill { background:var(--signal); }

  .severity-bar { display:flex; gap:3px; height:14px; margin-bottom:28px; }
  .severity-bar span { flex:1 1 0; background:var(--severity-color); transition:flex-grow 200ms ease-out; }
  .severity-legend { list-style:none; margin:0; padding:0; }
  .severity-legend li { display:grid; grid-template-columns:16px minmax(0,1fr) auto 56px; gap:12px; align-items:center; padding-block:10px; border-bottom:1px solid var(--line); font-size:.9375rem; }
  .legend-dot { width:7px; height:7px; border-radius:50%; background:var(--severity-color); }
  .legend-pct { color:var(--muted); font-weight:400; text-align:right; }

  .toolbar { display:flex; flex-direction:column; gap:20px; padding:40px 0 32px; }
  .toolbar-filters { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:16px 40px; }
  .toolbar-pills { display:flex; flex-wrap:wrap; gap:4px 28px; }

  .archive-empty { display:flex; flex-direction:column; align-items:center; gap:16px; padding:72px 0; border-bottom:1px solid var(--line); text-align:center; }
  .archive-empty[hidden] { display:none; }
  .archive-empty .section-index { margin:0; }
  .archive-empty p { font-size:1.25rem; font-weight:500; letter-spacing:-.02em; }

  .disclosure { display:flex; flex-wrap:wrap; justify-content:space-between; align-items:flex-end; gap:24px 64px; margin-top:72px; padding-top:28px; border-top:1px solid var(--ink); }
  .disclosure div { max-width:56ch; }
  .disclosure p { font-size:1.0625rem; }

  @media (max-width:1000px) {
    .archive-top, .overview { grid-template-columns:minmax(0,1fr); }
    .overview { gap:40px; }
  }
  @media (max-width:700px) {
    .archive-top { gap:32px; margin-bottom:40px; }
    .stats { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .stat + .stat:nth-child(3) { padding-left:0; border-left:0; }
    .stat:nth-child(n+3) { border-top:1px solid var(--line); }
    .stat-value { font-size:2.5rem; }
  }
</style>
