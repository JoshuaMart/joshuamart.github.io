---
import { Icon } from 'astro-icon/components';
import MainLayout from '../layouts/MainLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import FilterPills from '../components/FilterPills.astro';
import CveTable from '../components/CveTable.astro';
import cves from '../data/cves.json';

// Compute stats
const totalCves = cves.length;
const criticalCount = cves.filter((c) => c.severity === 'Critical').length;
const years = [...new Set(cves.map((c) => c.date))].sort((a, b) => b.localeCompare(a));

// Sort by date descending (most recent first)
const sortedCves = [...cves].sort((a, b) => b.date.localeCompare(a.date));

const stats = [
  { label: 'Total CVEs', value: totalCves },
  { label: 'Critical Findings', value: criticalCount },
  { label: 'Years Active', value: years.length },
];

const yearItems = [
  { value: 'all', label: 'All' },
  ...years.map((y) => ({ value: y, label: y })),
];
---

<MainLayout
  title="Vulnerability Research - Joshua Martinelle"
  description="Comprehensive database of disclosed security vulnerabilities discovered by Joshua Martinelle."
>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 sm:py-20">
    <PageHeader
      title="CVEs & Research."
      description="An archive of identified vulnerabilities and security research. Documenting structural flaws in high-value systems to advance defensive strategies."
    />

    <!-- Stats strip -->
    <div class="mb-12 grid grid-cols-3 divide-x divide-outline-variant border-y border-outline-variant">
      {stats.map((stat) => (
        <div class="px-4 py-6 sm:px-6">
          <p class="font-serif text-3xl font-medium text-paper sm:text-4xl">{stat.value}</p>
          <p class="mt-2 font-mono text-[10px] uppercase tracking-widest text-sand sm:text-xs">
            {stat.label}
          </p>
        </div>
      ))}
    </div>

    <!-- Search -->
    <div class="relative mb-6">
      <Icon
        name="lucide:search"
        class="absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-sand"
      />
      <input
        type="text"
        id="cve-search"
        placeholder="Search by CVE ID, product, or vulnerability type..."
        class="w-full border border-outline-variant bg-surface-container py-3 pl-11 pr-24 text-sm text-paper placeholder:text-sand focus:border-ochre focus:outline-none"
      />
      <span class="absolute right-4 top-1/2 -translate-y-1/2 border border-outline-variant bg-surface-low px-2 py-0.5 font-mono text-xs text-sand">
        CTRL + K
      </span>
    </div>

    <!-- Year filters -->
    <div class="mb-8">
      <FilterPills items={yearItems} group="years" label="Filter Year" />
    </div>

    <!-- CVE Table -->
    <div id="cve-container">
      <CveTable cves={sortedCves} />
    </div>

    <!-- Results count -->
    <p class="mt-6 font-mono text-xs uppercase tracking-widest text-sand">
      Showing <span id="shown-count">{totalCves}</span> of {totalCves} results
    </p>
  </section>

  <script>
    const searchInput = document.getElementById('cve-search') as HTMLInputElement;
    const rows = document.querySelectorAll<HTMLElement>('.cve-row');
    const shownCount = document.getElementById('shown-count');

    let currentYear = 'all';

    function applyFilters() {
      const term = searchInput.value.toLowerCase();
      // Rows contain both desktop table rows and mobile cards; a row is "shown"
      // when it matches, but only the visible breakpoint variant is on screen.
      const shownIds = new Set<string>();

      rows.forEach((row) => {
        const id = row.dataset.cveId || '';
        const target = row.dataset.cveTarget || '';
        const type = row.dataset.cveType || '';
        const year = row.dataset.cveYear || '';

        const matchesSearch =
          id.includes(term) || target.includes(term) || type.includes(term);
        const matchesYear = currentYear === 'all' || year === currentYear;
        const visible = matchesSearch && matchesYear;

        row.style.display = visible ? '' : 'none';
        if (visible) shownIds.add(id);
      });

      if (shownCount) shownCount.textContent = String(shownIds.size);
    }

    searchInput.addEventListener('input', applyFilters);

    document.addEventListener('filter-change', (e) => {
      const detail = (e as CustomEvent).detail;
      if (detail.group !== 'years') return;
      currentYear = detail.value;
      applyFilters();
    });

    document.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
        e.preventDefault();
        searchInput.focus();
      }
    });
  </script>
</MainLayout>
