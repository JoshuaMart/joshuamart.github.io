---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import FilterPills from '../../components/FilterPills.astro';
import PostListItem from '../../components/PostListItem.astro';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const allTags = [...new Set(posts.flatMap((post) => post.data.tags || []))].sort();
const tagItems = [
  { value: 'all', label: './ALL' },
  ...allTags.map((t) => ({ value: t, label: `#${t}` })),
];
---

<MainLayout
  title="Blog - Joshua Martinelle"
  description="Technical articles about security research, bug bounty, and malware analysis."
>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 sm:py-20">
    <PageHeader
      title="Research Journal"
      description="Analysis, methodologies, and technical perspectives on contemporary security challenges."
      class="border-b border-outline-variant pb-10"
    />

    <!-- Tag filters -->
    <div class="mb-12">
      <FilterPills items={tagItems} group="tags" />
    </div>

    <!-- Article list -->
    <div id="posts-list" class="flex flex-col">
      {sortedPosts.map((post) => (
        <PostListItem
          title={post.data.title}
          description={post.data.description}
          date={post.data.date}
          slug={post.id}
          tags={post.data.tags}
        />
      ))}
    </div>

    <p id="posts-empty" class="hidden py-16 text-center text-sand">
      No articles match this filter.
    </p>
  </section>

  <script>
    const items = document.querySelectorAll<HTMLElement>('.post-item');
    const empty = document.getElementById('posts-empty');

    document.addEventListener('filter-change', (e) => {
      const detail = (e as CustomEvent).detail;
      if (detail.group !== 'tags') return;
      const filter = detail.value;
      let visibleCount = 0;

      items.forEach((item) => {
        const tags = JSON.parse(item.dataset.tags || '[]');
        const visible = filter === 'all' || tags.includes(filter);
        item.style.display = visible ? '' : 'none';
        if (visible) visibleCount++;
      });

      if (empty) empty.classList.toggle('hidden', visibleCount > 0);
    });
  </script>
</MainLayout>
