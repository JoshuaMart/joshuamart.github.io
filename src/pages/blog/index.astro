---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostListItem from '../../components/PostListItem.astro';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const allTags = [...new Set(posts.flatMap((post) => post.data.tags || []))].sort();

---

<MainLayout
  title="Blog - Joshua Martinelle"
  description="Technical articles about security research, bug bounty, and malware analysis."
>
  <section class="site-shell page-shell">
    <PageHeader
      eyebrow="WRITING"
      title="Research, written down."
      description="Findings, experiments and notes from my work in web security."
      class="border-b border-outline-variant pb-10"
    />

    <!-- Tag filters -->
    <div class="mb-8 flex flex-wrap items-center justify-between gap-4">
      <p id="post-count" class="text-sm text-sand" role="status">{posts.length} articles</p>
      <div class="flex items-center gap-3"><label for="topic-filter" class="text-sm text-sand">Topic</label><select id="topic-filter" class="min-h-12 max-w-full border border-outline-variant bg-background px-4 py-2 text-base"><option value="all">All topics</option>{allTags.map(tag => <option value={tag}>{tag}</option>)}</select></div>
    </div>

    <!-- Article list -->
    <div id="posts-list" class="flex flex-col">
      {sortedPosts.map((post) => (
        <PostListItem
          title={post.data.title}
          description={post.data.description}
          date={post.data.date}
          slug={post.id}
          tags={post.data.tags}
        />
      ))}
    </div>

    <p id="posts-empty" class="hidden py-16 text-center text-sand">
      No articles match this filter.
    </p>
  </section>

  <script>
    const items = document.querySelectorAll<HTMLElement>('.post-item');
    const empty = document.getElementById('posts-empty');

    const topicFilter = document.getElementById('topic-filter') as HTMLSelectElement;
    topicFilter.addEventListener('change', () => {
      const filter = topicFilter.value;
      let visibleCount = 0;

      items.forEach((item) => {
        const tags = JSON.parse(item.dataset.tags || '[]');
        const visible = filter === 'all' || tags.includes(filter);
        item.style.display = visible ? '' : 'none';
        if (visible) visibleCount++;
      });

      if (empty) empty.classList.toggle('hidden', visibleCount > 0);
      const count = document.getElementById('post-count');
      if (count) count.textContent = `${visibleCount} ${visibleCount === 1 ? 'article' : 'articles'}`;
    });
  </script>
</MainLayout>
