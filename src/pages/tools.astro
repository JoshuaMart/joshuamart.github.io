---
import { Icon } from 'astro-icon/components';
import MainLayout from '../layouts/MainLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import FilterPills from '../components/FilterPills.astro';
import ToolCard from '../components/ToolCard.astro';
import { siteConfig, socialLinks } from '../data/site';
import tools from '../data/tools.json';

const languages = [...new Set(tools.map((t) => t.language))].sort();
const languageItems = [
  { value: 'all', label: 'All' },
  ...languages.map((l) => ({ value: l, label: l })),
];

const githubUrl = socialLinks.find((l) => l.name === 'GitHub')?.href ?? '#';
---

<MainLayout
  title="Tools - Joshua Martinelle"
  description="A collection of open source security tools, automation scripts, and vulnerability scanners."
>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 sm:py-20">
    <PageHeader
      eyebrow="Open Source"
      title="Security Tools"
      description="A collection of specialized utilities engineered for vulnerability research, automated reconnaissance, and system integrity analysis. Designed for precision and speed, and open-sourced for the broader security community."
    />

    <!-- Search & filters -->
    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="relative max-w-md flex-1">
        <Icon
          name="lucide:search"
          class="absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-sand"
        />
        <input
          type="text"
          id="tool-search"
          placeholder="Search repositories (e.g. 'recon', 'scanner')..."
          class="w-full border border-outline-variant bg-surface-container py-2.5 pl-11 pr-4 text-sm text-paper placeholder:text-sand focus:border-ochre focus:outline-none"
        />
      </div>
      <FilterPills items={languageItems} group="languages" />
    </div>

    <!-- Tools grid -->
    <div id="tools-grid" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {tools.map((tool) => (
        <ToolCard
          name={tool.name}
          description={tool.description}
          language={tool.language}
          icon={tool.icon}
          url={tool.url}
        />
      ))}
    </div>

    <p id="tools-empty" class="hidden border border-outline-variant bg-surface-container p-10 text-center text-sand">
      No tools match your search.
    </p>

    <!-- More on GitHub -->
    <div class="mt-24 flex flex-col items-start justify-between gap-6 border-t border-outline-variant pt-12 md:flex-row md:items-center">
      <div>
        <h3 class="mb-2 font-serif text-2xl font-medium text-paper">More on GitHub</h3>
        <p class="max-w-md text-sm text-sand">
          Scripts, dotfiles, and minor utilities are available in the public repositories.
        </p>
      </div>
      <a
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-ochre transition-colors hover:text-paper"
      >
        View Full Profile
        <Icon name="lucide:arrow-right" class="h-4 w-4" />
      </a>
    </div>
  </section>

  <script>
    const searchInput = document.getElementById('tool-search') as HTMLInputElement;
    const cards = document.querySelectorAll<HTMLElement>('.tool-card');
    const empty = document.getElementById('tools-empty');

    let currentLang = 'all';

    function applyFilters() {
      const term = searchInput.value.toLowerCase();
      let visibleCount = 0;

      cards.forEach((card) => {
        const name = card.dataset.name || '';
        const description = card.dataset.description || '';
        const language = card.dataset.language || '';

        const matchesSearch = name.includes(term) || description.includes(term);
        const matchesLang = currentLang === 'all' || language === currentLang;
        const visible = matchesSearch && matchesLang;

        card.style.display = visible ? '' : 'none';
        if (visible) visibleCount++;
      });

      if (empty) empty.classList.toggle('hidden', visibleCount > 0);
    }

    searchInput.addEventListener('input', applyFilters);

    document.addEventListener('filter-change', (e) => {
      const detail = (e as CustomEvent).detail;
      if (detail.group !== 'languages') return;
      currentLang = detail.value;
      applyFilters();
    });
  </script>
</MainLayout>
